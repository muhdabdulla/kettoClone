{
  "name": "ketto-clone",
  "version": "1.0.0",
  "description": "Ketto Crowdfunding Website Full-Stack Clone",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
